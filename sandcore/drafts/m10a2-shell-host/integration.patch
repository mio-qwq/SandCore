+     * 用户执行机会。防御性复制失败仍撤未运行孩子，不能留下未知启动。 */
+    if(paging_user_copy(TASK(pid).pd,output,&result,sizeof(result),1)){
+        task_stop(child);
+        return SC32_E_INVALID;
+    }
+    return SC32_OK;
+}
+
+static int host_query(int pid,u32 request,u32 output,int restart)
