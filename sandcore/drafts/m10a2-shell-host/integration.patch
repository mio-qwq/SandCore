+    session_t *scope=session_get(p->session);
+    if(!scope || scope->closing || scope->kind!=SESSION_NORMAL || p->pid)return;
+    if(p->attempts>=4){p->state=SC32_SHELL_RETRY_EXHAUSTED;return;}
+    p->attempts++;
