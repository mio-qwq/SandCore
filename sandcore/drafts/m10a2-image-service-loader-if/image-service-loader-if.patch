-        task_render_hold(1);sti();int worker=auth_service_exec(command,i);cli();task_render_hold(0);
-        if(worker<0){fail(&IMAGE_JOB(i),-3);return;}
-        IMAGE_JOB(i).worker=active_worker=worker;
