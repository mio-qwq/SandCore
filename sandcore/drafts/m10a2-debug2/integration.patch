+    }
+    else if(op==0xc2 || op==0xc3){name="ret";
+        if(op==0xc2)snprintf(a,sizeof(a),"0x%X",d2_take(&c,2));
+    }
+    else if(op==0xc6 || op==0xc7){name="mov";
+        modrm=1;
+        int width=op==0xc6?8:c.width;
